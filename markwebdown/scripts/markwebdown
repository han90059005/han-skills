#!/usr/bin/env bash
# markwebdown 启动器：固定用 crawl4ai 的 uv tool 环境跑 fetch_md.py
set -euo pipefail

PY="${CRAWL4AI_PYTHON:-$HOME/AppData/Roaming/uv/tools/crawl4ai/Scripts/python.exe}"

if [ ! -x "$PY" ]; then
  echo "找不到 crawl4ai 解释器: $PY" >&2
  echo "先跑: uv tool install crawl4ai && crawl4ai-setup" >&2
  exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONIOENCODING="${PYTHONIOENCODING:-utf-8}"
exec "$PY" "$SCRIPT_DIR/fetch_md.py" "$@"
